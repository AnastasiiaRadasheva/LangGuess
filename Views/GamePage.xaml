<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:LangGuess.Models"
             xmlns:svc="clr-namespace:LangGuess.Services"
             x:Class="LangGuess.Views.GamePage"
             BackgroundColor="{AppThemeBinding Light=#F5F0FF, Dark=#0A0714}">

    <AbsoluteLayout x:Name="RootLayout">

        <!-- ═══════  MAIN GAME  ═══════ -->
        <Grid AbsoluteLayout.LayoutBounds="0,0,1,1"
              AbsoluteLayout.LayoutFlags="SizeProportional"
              RowSpacing="0"
              IsVisible="{Binding AlreadyPlayed, Converter={StaticResource InvertBool}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="130"/>
            </Grid.RowDefinitions>

            <!-- HEADER -->
            <Grid Grid.Row="0"
                  BackgroundColor="{AppThemeBinding Light=#EDE8FF, Dark=#130D24}"
                  Padding="12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Text="&#9432;"
                        BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#2A1F45}"
                        TextColor="{AppThemeBinding Light=#6D28D9, Dark=#9B8EC4}"
                        FontSize="18" CornerRadius="6" Padding="10,6" Margin="0,0,6,0"
                        Clicked="OnDrawerToggleClicked"/>
                <Button Grid.Column="1" Text="&#8592;"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#6D28D9, Dark=#9B8EC4}"
                        FontSize="20" Padding="0,0,8,0"
                        Command="{Binding BackCommand}"/>
                <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                    <Label Text="LangGuess — Daily"
                           TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                           FontSize="18" FontAttributes="Bold"/>
                    <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[WelcomeSub]}"
                           TextColor="{AppThemeBinding Light=#8B7DC5, Dark=#5C5080}"
                           FontSize="10"/>
                </VerticalStackLayout>
                <Border Grid.Column="3"
                        BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#1E1540}"
                        StrokeShape="RoundRectangle 6"
                        Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}"
                        StrokeThickness="1" Padding="10,6" Margin="0,0,8,0"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="Streak:"
                               TextColor="{AppThemeBinding Light=#8B7DC5, Dark=#9B8EC4}"
                               FontSize="12" VerticalOptions="Center"/>
                        <Label Text="{Binding Streak}"
                               TextColor="#F0A500" FontSize="15" FontAttributes="Bold"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
                <Button Grid.Column="4" Text="&#9881;"
                        BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#2A1F45}"
                        TextColor="{AppThemeBinding Light=#6D28D9, Dark=#9B8EC4}"
                        FontSize="18" CornerRadius="6" Padding="10,6"
                        Command="{Binding GoToSettingsCommand}"/>
            </Grid>

            <!-- COLUMN HEADERS -->
            <ScrollView Grid.Row="1" x:Name="HeaderScroll"
                        Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        BackgroundColor="{AppThemeBinding Light=#EDE8FF, Dark=#130D24}">
                <Grid WidthRequest="560" ColumnSpacing="2" Padding="4,6,4,4"
                      ColumnDefinitions="88,56,56,52,60,52,56,56">
                    <Border Grid.Column="0" BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#1A1430}" StrokeShape="RoundRectangle 4" Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}" StrokeThickness="1" Padding="4,4">
                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColLang]}" Style="{StaticResource ColHeader}"/>
                    </Border>
                    <Border Grid.Column="1" BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#1A1430}" StrokeShape="RoundRectangle 4" Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}" StrokeThickness="1" Padding="4,4">
                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColYear]}" Style="{StaticResource ColHeader}"/>
                    </Border>
                    <Border Grid.Column="2" BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#1A1430}" StrokeShape="RoundRectangle 4" Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}" StrokeThickness="1" Padding="4,4">
                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColPara]}" Style="{StaticResource ColHeader}"/>
                    </Border>
                    <Border Grid.Column="3" BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#1A1430}" StrokeShape="RoundRectangle 4" Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}" StrokeThickness="1" Padding="4,4">
                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColType]}" Style="{StaticResource ColHeader}"/>
                    </Border>
                    <Border Grid.Column="4" BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#1A1430}" StrokeShape="RoundRectangle 4" Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}" StrokeThickness="1" Padding="4,4">
                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColComp]}" Style="{StaticResource ColHeader}"/>
                    </Border>
                    <Border Grid.Column="5" BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#1A1430}" StrokeShape="RoundRectangle 4" Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}" StrokeThickness="1" Padding="4,4">
                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColPlat]}" Style="{StaticResource ColHeader}"/>
                    </Border>
                    <Border Grid.Column="6" BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#1A1430}" StrokeShape="RoundRectangle 4" Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}" StrokeThickness="1" Padding="4,4">
                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColPop]}" Style="{StaticResource ColHeader}"/>
                    </Border>
                    <Border Grid.Column="7" BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#1A1430}" StrokeShape="RoundRectangle 4" Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}" StrokeThickness="1" Padding="4,4">
                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ColGC]}" Style="{StaticResource ColHeader}"/>
                    </Border>
                </Grid>
            </ScrollView>

            <!-- GUESS ROWS -->
            <ScrollView Grid.Row="2" x:Name="RowsScroll"
                        Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <CollectionView ItemsSource="{Binding GuessRows}" WidthRequest="560">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:GuessResultRow">
                            <Grid ColumnSpacing="2" Margin="4,2,4,0"
                                  ColumnDefinitions="88,56,56,52,60,52,56,56">
                                <Border Grid.Column="0" BackgroundColor="{Binding AbbrColor}" StrokeShape="RoundRectangle 4" Stroke="#3A2D5C" StrokeThickness="1" Padding="4,6">
                                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding Abbr}" TextColor="#A374FF" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"/>
                                        <Label Text="{Binding LanguageName}" TextColor="White" FontSize="9" HorizontalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="1" BackgroundColor="{Binding YearColor}" StrokeShape="RoundRectangle 4" Stroke="#3A2D5C" StrokeThickness="1" Padding="2,3">
                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding Year}" TextColor="White" FontSize="10" FontAttributes="Bold" HorizontalOptions="Center"/>
                                        <Label Text="{Binding YearArrow}" TextColor="{Binding YearArrowColor}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" IsVisible="{Binding YearArrow, Converter={StaticResource NotEmptyBool}}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="2" BackgroundColor="{Binding ParadigmColor}" StrokeShape="RoundRectangle 4" Stroke="#3A2D5C" StrokeThickness="1" Padding="2,3">
                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding Paradigm}" Style="{StaticResource CellLabel}" FontSize="9"/>
                                        <Label Text="{Binding ParadigmArrow}" TextColor="{Binding ParadigmArrowColor}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" IsVisible="{Binding ParadigmArrow, Converter={StaticResource NotEmptyBool}}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="3" BackgroundColor="{Binding TypingColor}" StrokeShape="RoundRectangle 4" Stroke="#3A2D5C" StrokeThickness="1" Padding="2,3">
                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding Typing}" Style="{StaticResource CellLabel}" FontSize="9"/>
                                        <Label Text="{Binding TypingArrow}" TextColor="{Binding TypingArrowColor}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" IsVisible="{Binding TypingArrow, Converter={StaticResource NotEmptyBool}}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="4" BackgroundColor="{Binding CompilationColor}" StrokeShape="RoundRectangle 4" Stroke="#3A2D5C" StrokeThickness="1" Padding="2,3">
                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding Compilation}" Style="{StaticResource CellLabel}" FontSize="9"/>
                                        <Label Text="{Binding CompilationArrow}" TextColor="{Binding CompilationArrowColor}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" IsVisible="{Binding CompilationArrow, Converter={StaticResource NotEmptyBool}}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="5" BackgroundColor="{Binding PlatformColor}" StrokeShape="RoundRectangle 4" Stroke="#3A2D5C" StrokeThickness="1" Padding="2,3">
                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding Platform}" Style="{StaticResource CellLabel}" FontSize="9"/>
                                        <Label Text="{Binding PlatformArrow}" TextColor="{Binding PlatformArrowColor}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" IsVisible="{Binding PlatformArrow, Converter={StaticResource NotEmptyBool}}"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="6" BackgroundColor="{Binding PopularityColor}" StrokeShape="RoundRectangle 4" Stroke="#3A2D5C" StrokeThickness="1" Padding="2,3">
                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding Popularity}" Style="{StaticResource CellLabel}" FontSize="9"/>
                                    </VerticalStackLayout>
                                </Border>
                                <Border Grid.Column="7" BackgroundColor="{Binding GCTypeColor}" StrokeShape="RoundRectangle 4" Stroke="#3A2D5C" StrokeThickness="1" Padding="2,3">
                                    <VerticalStackLayout Spacing="0" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label Text="{Binding GCType}" Style="{StaticResource CellLabel}" FontSize="9"/>
                                        <Label Text="{Binding GCTypeArrow}" TextColor="{Binding GCTypeArrowColor}" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center" IsVisible="{Binding GCTypeArrow, Converter={StaticResource NotEmptyBool}}"/>
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </ScrollView>

            <!-- STATUS -->
            <VerticalStackLayout Grid.Row="3" Spacing="6" Padding="12,4,12,4">
                <Border IsVisible="{Binding IsWon}"
                        BackgroundColor="#0F3D1A" StrokeShape="RoundRectangle 8"
                        Stroke="#2EA043" StrokeThickness="1.5" Padding="12,8">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[WinMsg]}"
                               TextColor="#6EE7A0" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <Border IsVisible="{Binding IsLost}"
                        BackgroundColor="#3D0F0F" StrokeShape="RoundRectangle 8"
                        Stroke="#C0392B" StrokeThickness="1.5" Padding="12,8">
                    <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LossMsg]}"
                               TextColor="#FF8080" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="{Binding StatusMessage}"
                               TextColor="White" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6"
                                       IsVisible="{Binding IsGameOver, Converter={StaticResource InvertBool}}">
                    <Label Text="Attempts:"
                           TextColor="{AppThemeBinding Light=#8B7DC5, Dark=#5C5080}"
                           FontSize="12" VerticalOptions="Center"/>
                    <Label TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                           FontSize="12" FontAttributes="Bold" VerticalOptions="Center">
                        <Label.Text>
                            <MultiBinding StringFormat="{}{0}/6">
                                <Binding Path="AttemptsLeft"/>
                            </MultiBinding>
                        </Label.Text>
                    </Label>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- LANGUAGE CARDS -->
            <Grid Grid.Row="4" BackgroundColor="{AppThemeBinding Light=#EDE8FF, Dark=#130D24}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <BoxView Grid.Row="0" HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}" Margin="0"/>
                <ScrollView Grid.Row="1" Orientation="Horizontal">
                    <HorizontalStackLayout x:Name="LangLayout" Spacing="8" Padding="10,8"/>
                </ScrollView>
            </Grid>
        </Grid>

        <!-- ═══════  ALREADY PLAYED TODAY  ═══════ -->
        <ScrollView AbsoluteLayout.LayoutBounds="0,0,1,1"
                    AbsoluteLayout.LayoutFlags="SizeProportional"
                    IsVisible="{Binding AlreadyPlayed}">
            <VerticalStackLayout Spacing="0">

                <!-- Header -->
                <Grid BackgroundColor="{AppThemeBinding Light=#EDE8FF, Dark=#130D24}" Padding="12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Text="&#8592;"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                            FontSize="20" Padding="0,0,8,0"
                            Command="{Binding BackCommand}"/>
                    <Label Grid.Column="1" Text="LangGuess — Daily"
                           TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                           FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Button Grid.Column="2" Text="&#9881;"
                            BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#2A1F45}"
                            TextColor="{AppThemeBinding Light=#6D28D9, Dark=#9B8EC4}"
                            FontSize="18" CornerRadius="6" Padding="10,6"
                            Command="{Binding GoToSettingsCommand}"/>
                </Grid>

                <!-- Already played card -->
                <Border Margin="20,30,20,0"
                        BackgroundColor="{AppThemeBinding Light=#EDE8FF, Dark=#130D24}"
                        Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}"
                        StrokeThickness="1.5" StrokeShape="RoundRectangle 16" Padding="24,24">
                    <VerticalStackLayout Spacing="16" HorizontalOptions="Center">

                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AlreadyPlayedTitle]}"
                               TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                               FontSize="20" FontAttributes="Bold" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>

                        <!-- Win / Loss badge -->
                        <Border Padding="16,8" StrokeShape="RoundRectangle 10" StrokeThickness="0"
                                HorizontalOptions="Center">
                            <Border.BackgroundColor>
                                <Binding Path="TodayWon">
                                    <Binding.Converter><StaticResource Key="BoolToWinColor"/></Binding.Converter>
                                </Binding>
                            </Border.BackgroundColor>
                            <Label FontSize="15" FontAttributes="Bold" TextColor="White"
                                   HorizontalOptions="Center">
                                <Label.Text>
                                    <Binding Path="TodayWon">
                                        <Binding.Converter><StaticResource Key="BoolToWinText"/></Binding.Converter>
                                    </Binding>
                                </Label.Text>
                            </Label>
                        </Border>

                        <!-- Language + attempts -->
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[TodaysAnswer]}"
                                   TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}"
                                   FontSize="13" HorizontalOptions="Center"/>
                            <Label Text="{Binding TodayLang}"
                                   TextColor="{AppThemeBinding Light=#1A1035, Dark=#E2D9F3}"
                                   FontSize="26" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="{Binding TodayAttempts}"
                                   TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}"
                                   FontSize="14" HorizontalOptions="Center"/>
                        </VerticalStackLayout>

                        <!-- Streak -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                            <Label Text="Streak:"
                                   TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}"
                                   FontSize="14" VerticalOptions="Center"/>
                            <Label Text="{Binding Streak}"
                                   TextColor="#F0A500" FontSize="22" FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[AlreadyPlayedSub]}"
                               TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}"
                               FontSize="13" HorizontalOptions="Center"
                               HorizontalTextAlignment="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Go to Score Mode button -->
                <Button Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[GoToScore]}"
                        Command="{Binding GoToScoreCommand}"
                        BackgroundColor="{AppThemeBinding Light=#6D28D9, Dark=#5E3BA8}"
                        TextColor="White" FontSize="16" FontAttributes="Bold"
                        CornerRadius="12" HeightRequest="54" Margin="20,24,20,0"/>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══════  DRAWER DIM  ═══════ -->
        <BoxView x:Name="DrawerDim"
                 AbsoluteLayout.LayoutBounds="0,0,1,1"
                 AbsoluteLayout.LayoutFlags="SizeProportional"
                 BackgroundColor="#000000" Opacity="0" IsVisible="False">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnDimTapped"/>
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- ═══════  DRAWER PANEL  ═══════ -->
        <Grid x:Name="DrawerPanel"
              AbsoluteLayout.LayoutBounds="0,0,290,1"
              AbsoluteLayout.LayoutFlags="HeightProportional"
              BackgroundColor="{AppThemeBinding Light=#EDE8FF, Dark=#0E0B1C}"
              TranslationX="-290">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="16,16,16,10"
                  BackgroundColor="{AppThemeBinding Light=#DDD6FF, Dark=#130D24}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"
                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LangInfoTitle]}"
                       TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                       FontSize="16" FontAttributes="Bold" VerticalOptions="Center"/>
                <Button Grid.Column="1" Text="&#10005;"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#6D28D9, Dark=#9B8EC4}"
                        FontSize="18" Padding="4"
                        Clicked="OnDrawerCloseClicked"/>
            </Grid>
            <ScrollView Grid.Row="1">
                <VerticalStackLayout x:Name="DrawerLangList" Spacing="0" Padding="0"/>
            </ScrollView>
        </Grid>

    </AbsoluteLayout>
</ContentPage>
