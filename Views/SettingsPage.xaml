<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LangGuess.ViewModels"
             xmlns:models="clr-namespace:LangGuess.Models"
             xmlns:svc="clr-namespace:LangGuess.Services"
             x:Class="LangGuess.Views.SettingsPage"
             BackgroundColor="{AppThemeBinding Light=#F5F0FF, Dark=#0A0714}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header -->
            <Grid BackgroundColor="{AppThemeBinding Light=#EDE8FF, Dark=#130D24}" Padding="12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Text="&#8592;"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                        FontSize="20" Command="{Binding BackCommand}" Padding="0"/>
                <Label Grid.Column="1"
                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Settings]}"
                       TextColor="{AppThemeBinding Light=#1A1035, Dark=#E2D9F3}"
                       FontSize="18" FontAttributes="Bold" VerticalOptions="Center" Margin="8,0"/>
            </Grid>

            <!-- Player name card -->
            <Border Margin="12,12,12,0"
                    BackgroundColor="{AppThemeBinding Light=#EDE8FF, Dark=#130D24}"
                    Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[PlayerNameLabel]}"
                           TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}" FontSize="12"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Border Grid.Column="0"
                                BackgroundColor="{AppThemeBinding Light=#F5F0FF, Dark=#0A0714}"
                                Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 8" Padding="10,6">
                            <Entry Text="{Binding PlayerName}"
                                   Placeholder="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[PlayerNameHint]}"
                                   TextColor="{AppThemeBinding Light=#1A1035, Dark=#E2D9F3}"
                                   PlaceholderColor="{AppThemeBinding Light=#8B7DC5, Dark=#5C5080}"
                                   BackgroundColor="Transparent"
                                   FontSize="14"/>
                        </Border>
                        <Button Grid.Column="1"
                                Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SaveBtn]}"
                                Command="{Binding SaveNameCommand}"
                                BackgroundColor="{AppThemeBinding Light=#6D28D9, Dark=#5E3BA8}"
                                TextColor="White" FontSize="13" CornerRadius="8" Padding="14,8"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Settings card -->
            <Border Margin="12,12,12,0"
                    BackgroundColor="{AppThemeBinding Light=#EDE8FF, Dark=#130D24}"
                    Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}"
                    StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="16">
                <VerticalStackLayout Spacing="18">

                    <!-- Language -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LanguageLabel]}"
                               TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}" FontSize="12"/>
                        <Picker ItemsSource="{Binding LanguageOptions}"
                                SelectedIndex="{Binding SelectedLanguageIndex}"
                                TextColor="{AppThemeBinding Light=#1A1035, Dark=#E2D9F3}"
                                BackgroundColor="{AppThemeBinding Light=#F5F0FF, Dark=#0A0714}"
                                FontSize="15"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}"/>

                    <!-- Dark mode -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ThemeLabel]}"
                                   TextColor="{AppThemeBinding Light=#1A1035, Dark=#E2D9F3}" FontSize="15"/>
                            <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ThemeSub]}"
                                   TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}" FontSize="12"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding IsDark}"
                                OnColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                                VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}"/>

                    <!-- Background music -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[MusicLabel]}"
                                   TextColor="{AppThemeBinding Light=#1A1035, Dark=#E2D9F3}" FontSize="15"/>
                            <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[MusicSub]}"
                                   TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}" FontSize="12"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding MusicEnabled}"
                                OnColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                                VerticalOptions="Center"/>
                    </Grid>

                    <!-- Music volume slider -->
                    <VerticalStackLayout Spacing="4" IsVisible="{Binding MusicEnabled}">
                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[MusicVolLabel]}"
                               TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}" FontSize="12"/>
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding MusicVolume}"
                                MinimumTrackColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                                MaximumTrackColor="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}"
                                ThumbColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}"/>

                    <!-- SFX -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SfxLabel]}"
                                   TextColor="{AppThemeBinding Light=#1A1035, Dark=#E2D9F3}" FontSize="15"/>
                            <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SfxSub]}"
                                   TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}" FontSize="12"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1" IsToggled="{Binding SfxEnabled}"
                                OnColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                                VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- History header + clear button -->
            <Grid Margin="16,16,16,6" ColumnDefinitions="*,Auto">
                <Label Grid.Column="0"
                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[HistoryTitle]}"
                       TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}"
                       FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                <Button Grid.Column="1"
                        Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ClearHistory]}"
                        Command="{Binding ClearHistoryCommand}"
                        BackgroundColor="#3D1515" TextColor="#FF6B6B"
                        FontSize="12" CornerRadius="8" Padding="12,6"
                        IsVisible="{Binding HasHistory}"/>
            </Grid>

            <!-- History list -->
            <CollectionView ItemsSource="{Binding History}" Margin="12,0,12,16">
                <CollectionView.EmptyView>
                    <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[NoHistory]}"
                           TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}"
                           FontSize="13" HorizontalOptions="Center" Margin="0,12"/>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameHistory">
                        <Border Margin="0,3"
                                BackgroundColor="{AppThemeBinding Light=#EDE8FF, Dark=#130D24}"
                                Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}"
                                StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Date}"
                                           TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}" FontSize="11"/>
                                    <Label Text="{Binding SecretLanguage}"
                                           TextColor="{AppThemeBinding Light=#1A1035, Dark=#E2D9F3}"
                                           FontSize="14" FontAttributes="Bold"/>
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}"
                                       FontSize="12" VerticalOptions="Center" Margin="0,0,12,0">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0}/6">
                                            <Binding Path="Attempts"/>
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                                <Border Grid.Column="2" Padding="8,4"
                                        StrokeShape="RoundRectangle 6" StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Border.BackgroundColor>
                                        <Binding Path="IsWon">
                                            <Binding.Converter><StaticResource Key="BoolToWinColor"/></Binding.Converter>
                                        </Binding>
                                    </Border.BackgroundColor>
                                    <Label FontSize="11" FontAttributes="Bold" TextColor="White">
                                        <Label.Text>
                                            <Binding Path="IsWon">
                                                <Binding.Converter><StaticResource Key="BoolToWinText"/></Binding.Converter>
                                            </Binding>
                                        </Label.Text>
                                    </Label>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
