<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:LangGuess.ViewModels"
             xmlns:models="clr-namespace:LangGuess.Models"
             xmlns:svc="clr-namespace:LangGuess.Services"
             x:Class="LangGuess.Views.SettingsPage"
             BackgroundColor="#0D1117">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Header -->
            <Grid BackgroundColor="#161B22" Padding="12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Text="←"
                        BackgroundColor="Transparent"
                        TextColor="#58A6FF"
                        FontSize="20"
                        Command="{Binding BackCommand}"
                        Padding="0"/>
                <Label Grid.Column="1"
                       Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Settings]}"
                       TextColor="#C9D1D9"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       Margin="8,0"/>
            </Grid>

            <!-- Settings card -->
            <Border Margin="12,12,12,0"
                    BackgroundColor="#161B22"
                    Stroke="#30363D"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 16"
                    Padding="16">
                <VerticalStackLayout Spacing="18">

                    <!-- Language -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[LanguageLabel]}"
                               TextColor="#8B949E" FontSize="12"/>
                        <Picker ItemsSource="{Binding LanguageOptions}"
                                SelectedIndex="{Binding SelectedLanguageIndex}"
                                TextColor="#C9D1D9"
                                BackgroundColor="#0D1117"
                                FontSize="15"/>
                    </VerticalStackLayout>

                    <!-- Separator -->
                    <BoxView HeightRequest="1" BackgroundColor="#30363D"/>

                    <!-- Dark / Light mode -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ThemeLabel]}"
                                   TextColor="#C9D1D9" FontSize="15"/>
                            <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[ThemeSub]}"
                                   TextColor="#8B949E" FontSize="12"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding IsDark}"
                                OnColor="#58A6FF"
                                VerticalOptions="Center"/>
                    </Grid>

                    <!-- Separator -->
                    <BoxView HeightRequest="1" BackgroundColor="#30363D"/>

                    <!-- Sound -->
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SoundLabel]}"
                                   TextColor="#C9D1D9" FontSize="15"/>
                            <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[SoundSub]}"
                                   TextColor="#8B949E" FontSize="12"/>
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding SoundEnabled}"
                                OnColor="#58A6FF"
                                VerticalOptions="Center"/>
                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- History header -->
            <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[HistoryTitle]}"
                   TextColor="#8B949E"
                   FontSize="13"
                   FontAttributes="Bold"
                   Margin="16,16,16,6"/>

            <!-- History list — uses DataTemplate -->
            <CollectionView ItemsSource="{Binding History}"
                            Margin="12,0,12,16">
                <CollectionView.EmptyView>
                    <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[NoHistory]}"
                           TextColor="#8B949E"
                           FontSize="13"
                           HorizontalOptions="Center"
                           Margin="0,12"/>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:GameHistory">
                        <Border Margin="0,3"
                                BackgroundColor="#161B22"
                                Stroke="#30363D"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 12"
                                Padding="14,10">
                            <Grid ColumnDefinitions="*,Auto,Auto">

                                <!-- Date + secret -->
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="{Binding Date}"
                                           TextColor="#8B949E"
                                           FontSize="11"/>
                                    <Label Text="{Binding SecretLanguage}"
                                           TextColor="#C9D1D9"
                                           FontSize="14"
                                           FontAttributes="Bold"/>
                                </VerticalStackLayout>

                                <!-- Attempts -->
                                <Label Grid.Column="1"
                                       TextColor="#8B949E"
                                       FontSize="12"
                                       VerticalOptions="Center"
                                       Margin="0,0,12,0">
                                    <Label.Text>
                                        <MultiBinding StringFormat="{}{0}/6">
                                            <Binding Path="Attempts"/>
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>

                                <!-- Won/Lost badge -->
                                <Border Grid.Column="2"
                                        Padding="8,4"
                                        StrokeShape="RoundRectangle 8"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Border.BackgroundColor>
                                        <Binding Path="IsWon">
                                            <Binding.Converter>
                                                <StaticResource Key="BoolToWinColor"/>
                                            </Binding.Converter>
                                        </Binding>
                                    </Border.BackgroundColor>
                                    <Label FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="White">
                                        <Label.Text>
                                            <Binding Path="IsWon">
                                                <Binding.Converter>
                                                    <StaticResource Key="BoolToWinText"/>
                                                </Binding.Converter>
                                            </Binding>
                                        </Label.Text>
                                    </Label>
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
