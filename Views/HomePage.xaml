<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:svc="clr-namespace:LangGuess.Services"
             x:Class="LangGuess.Views.HomePage"
             BackgroundColor="{AppThemeBinding Light=#F5F0FF, Dark=#0F0B1A}">

    <ScrollView>
        <VerticalStackLayout Spacing="0" Padding="0">

            <!-- TOP BAR -->
            <Grid BackgroundColor="{AppThemeBinding Light=#EDE8FF, Dark=#1C1730}" Padding="16,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Text="LangGuess"
                       TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                       FontSize="22" FontAttributes="Bold" VerticalOptions="Center"/>
                <Button Grid.Column="1" Text="⚙"
                        BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#2A1F45}"
                        TextColor="{AppThemeBinding Light=#6D28D9, Dark=#9B8EC4}"
                        FontSize="18" CornerRadius="10" Padding="10,6"
                        Command="{Binding GoToSettingsCommand}"/>
            </Grid>

            <!-- HERO SECTION -->
            <VerticalStackLayout Spacing="16" Padding="28,40,28,32" HorizontalOptions="Center">
                <Border BackgroundColor="{AppThemeBinding Light=#E3DBFF, Dark=#170F2E}"
                        StrokeShape="RoundRectangle 30"
                        Stroke="{AppThemeBinding Light=#7C3AED, Dark=#5E3BA8}"
                        StrokeThickness="2" WidthRequest="110" HeightRequest="110"
                        HorizontalOptions="Center">
                    <Label Text="&lt;/&gt;"
                           TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                           FontSize="42" FontAttributes="Bold"
                           HorizontalOptions="Center" VerticalOptions="Center"/>
                </Border>
                <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[Welcome]}"
                       TextColor="{AppThemeBinding Light=#1A1035, Dark=#E2D9F3}"
                       FontSize="24" FontAttributes="Bold"
                       HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
                <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[WelcomeSub]}"
                       TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}"
                       FontSize="14" HorizontalOptions="Center" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

            <!-- HOW TO PLAY -->
            <Border BackgroundColor="{AppThemeBinding Light=#EDE8FF, Dark=#1C1730}"
                    StrokeShape="RoundRectangle 16"
                    Stroke="{AppThemeBinding Light=#C4B5FD, Dark=#3A2D5C}"
                    StrokeThickness="1" Margin="20,0" Padding="20,16">
                <VerticalStackLayout Spacing="10">
                    <Label Text="How to play"
                           TextColor="{AppThemeBinding Light=#6D28D9, Dark=#A374FF}"
                           FontSize="14" FontAttributes="Bold"/>
                    <Label Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[HowTo]}"
                           TextColor="{AppThemeBinding Light=#5C4F7C, Dark=#9B8EC4}"
                           FontSize="12" LineBreakMode="WordWrap"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8" Margin="0,4,0,0">
                        <Border Grid.Column="0" BackgroundColor="#1A5C2E" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="8,6">
                            <Label Text="Correct" TextColor="White" FontSize="11" HorizontalOptions="Center"/>
                        </Border>
                        <Border Grid.Column="1" BackgroundColor="#5C4500" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="8,6">
                            <Label Text="Close" TextColor="White" FontSize="11" HorizontalOptions="Center"/>
                        </Border>
                        <Border Grid.Column="2" BackgroundColor="#5C1A1A" StrokeShape="RoundRectangle 8" Stroke="Transparent" Padding="8,6">
                            <Label Text="Wrong" TextColor="White" FontSize="11" HorizontalOptions="Center"/>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- PLAY BUTTON -->
            <Button Text="{Binding Source={x:Static svc:LocalizationService.Instance}, Path=[PlayBtn]}"
                    Command="{Binding PlayCommand}"
                    BackgroundColor="{AppThemeBinding Light=#6D28D9, Dark=#5E3BA8}"
                    TextColor="White" FontSize="18" FontAttributes="Bold"
                    CornerRadius="16" HeightRequest="60" Margin="20,28,20,40"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
