<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:LangGuess.Views"
       x:Class="LangGuess.AppShell"
       Shell.NavBarIsVisible="False">

    <ShellContent x:Name="HomeContent"
                  Route="HomePage"
                  ContentTemplate="{DataTemplate views:HomePage}"/>

    <ShellContent x:Name="GameContent"
                  Route="GamePage"
                  ContentTemplate="{DataTemplate views:GamePage}"/>

    <ShellContent x:Name="SettingsContent"
                  Route="SettingsPage"
                  ContentTemplate="{DataTemplate views:SettingsPage}"/>

</Shell>
